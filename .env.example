APP_NAME=transform-backend
DEBUG=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# PostgreSQL. Пароль сгенерируйте: openssl rand -hex 32
# Хост db — имя сервиса в docker-compose.yml
POSTGRES_DB=transform
POSTGRES_USER=transform
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://transform:change-me@db:5432/transform

# Локальный запуск без Nginx-прокси: раскомментируйте, чтобы убрать префикс /api
# ROOT_PATH=
